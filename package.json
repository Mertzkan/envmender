{
  "name": "envmender",
  "version": "0.1.0",
  "description": "A lightweight CLI to validate environment configuration files.",
  "type": "module",
  "bin": {
    "envmender": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "dotenv": "^18.0.7",
    "picocolors": "^1.1.1"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "dotenv",
    "environment",
    "cli",
    "validation",
    "typescript"
  ]
}
